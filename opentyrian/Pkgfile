# Description: Open source port of the DOS game Tyrian (1995)
# URL: https://github.com/akosela/opentyrian
# Maintainer: Jose Beneyto, sepen at crux-arm dot nu
# Depends on: sdl2_net

name=opentyrian
version=2.1.20221123
release=1
source=(https://github.com/opentyrian/opentyrian/archive/refs/tags/v$version.tar.gz
        https://camanis.net/tyrian/tyrian21.zip)

build() {
  cd $name-$version

  make prefix=/usr
  make prefix=/usr DESTDIR=$PKG install

  rm -rf $PKG/usr/share/doc

  install -d $PKG/usr/share/$name
  rm $SRC/tyrian21/*.exe
  mv $SRC/tyrian21 $PKG/usr/share/$name/data

  mv $PKG/usr/bin/$name $PKG/usr/share/$name/$name
  cat > $PKG/usr/bin/$name << __EOF__
#!/bin/sh

cd /usr/share/$name
exec ./$name \$@
__EOF__
  chmod +x $PKG/usr/bin/$name
}
