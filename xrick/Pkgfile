# Description: xrick is a clone of Rick Dangerous
# URL: https://www.bigorno.net/xrick/
# Maintainer: Jose Beneyto, sepen at crux-arm dot nu
# Depends on: libsdl zlib unzip

name=xrick
version=021212
release=1

source=(https://www.bigorno.net/xrick/xrick-021212.zip)

build() {
  cd $name-$version

  sed -i 's/-W -O2/-W -O2 -fcommon/' Makefile
  make

  install -d $PKG/usr/{bin,share/$name,share/man/man6}
  install -m 0755 $name $PKG/usr/share/$name/$name
  mv data.zip $name.dsp $PKG/usr/share/$name
  install -m 0644 $name.6.gz $PKG/usr/share/man/man6/$name.6.gz

  cat > $PKG/usr/bin/$name << __EOF__
#!/bin/sh

cd /usr/share/xrick
exec ./xrick \$@
__EOF__
  chmod +x $PKG/usr/bin/$name
}
